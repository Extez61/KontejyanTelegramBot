BOT_TOKEN=BURAYA_BOTFATHER_TOKENINI_YAZ
CHECK_INTERVAL=120
DB_PATH=eokul_bot.db
MAX_CONCURRENCY=4
MAX_SUBS_PER_USER=15
GROUP_TIMEOUT=90
LIST_TIMEOUT=120

# Yerel Webshare dosyası: IP:PORT:USERNAME:PASSWORD
USE_PROXY=1
PROXY_FILE=proxies.txt
# Şemasız satırlar HTTP proxy kabul edilir. Gerekirse socks5 yap.
PROXY_SCHEME=http
PROXY_LIST_URL=
# MEB sorguları proxy bozulursa doğrudan bağlantıya geçmesin.
DIRECT_FALLBACK=0
DIRECT_FIRST=0

# Dosya yerine Webshare indirme URL'si kullanacaksan:
# PROXY_FILE=
# PROXY_LIST_URL=GIZLI_HTTPS_INDIRME_BAGLANTIN

# Log ayrıntısı: error, warn, info, debug. Token ve proxy şifreleri gizlenir.
LOG_LEVEL=info
